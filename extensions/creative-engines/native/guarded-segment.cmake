# Inject the additive guarded ABI without modifying the user's engine checkout.
cmake_minimum_required(VERSION 3.19)
set(CREATIVE_SEGMENT_NATIVE_DIR "${CMAKE_CURRENT_LIST_DIR}")
function(creative_guard_segment)
  set(host_source "${CMAKE_CURRENT_SOURCE_DIR}/../src/ai/onnx_model_host.cpp")
  file(READ "${host_source}" host)
  string(FIND "${host}" "opts.AppendExecutionProvider_CUDA(cuda_opts);" cuda_marker)
  string(FIND "${host}" "s.active_provider = \"cuda\";" provider_marker)
  if(cuda_marker LESS 0 OR provider_marker LESS 0)
    message(FATAL_ERROR "Native model-host CUDA contract changed; review the guarded CPU-mode injection")
  endif()
  string(REPLACE "opts.AppendExecutionProvider_CUDA(cuda_opts);" "if (!creative_segment_cpu_only()) opts.AppendExecutionProvider_CUDA(cuda_opts);" host "${host}")
  string(REPLACE "s.active_provider = \"cuda\";" "s.active_provider = creative_segment_cpu_only() ? \"cpu\" : \"cuda\";" host "${host}")
  set(guarded_host "${CMAKE_CURRENT_BINARY_DIR}/creative_onnx_model_host.cpp")
  file(WRITE "${guarded_host}" "extern bool creative_segment_cpu_only() noexcept;\n${host}")
  get_target_property(engine_sources libomni_image_bridge SOURCES)
  list(FILTER engine_sources EXCLUDE REGEX "src/ai/onnx_model_host\\.cpp$")
  set_property(TARGET libomni_image_bridge PROPERTY SOURCES ${engine_sources})
  target_sources(libomni_image_bridge PRIVATE "${guarded_host}" "${CREATIVE_SEGMENT_NATIVE_DIR}/guarded-segment.cpp")
endfunction()
cmake_language(DEFER CALL creative_guard_segment)
